<Project>

  <PropertyGroup>
    <IsCsfAnalyzerPackage Condition="
      '$(MSBuildProjectName)' == 'CSF.Analyzers.Reliability'
      Or '$(MSBuildProjectName)' == 'CSF.Analyzers.Architecture'
      Or '$(MSBuildProjectName)' == 'CSF.Analyzers.Testing'">true</IsCsfAnalyzerPackage>
    <RepositoryUrl>https://github.com/rodri-oliveira-dev/Swa.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rodri-oliveira-dev/Swa.Analyzers</PackageProjectUrl>
    <Authors>Rodrigo Oliveira</Authors>
    <Company>Rodrigo Oliveira</Company>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsCsfAnalyzerPackage)' == 'true'">
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsCsfAnalyzerPackage)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <Compile Include="$(MSBuildThisFileDirectory)src\CSF.Analyzers.Common\**\*.cs"
             LinkBase="Common" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\" />
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
    <None Include="$(OutputPath)$(AssemblyName).pdb"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

</Project>
