{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Swa.Analyzers.SampleApp (dotnet run)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/Swa.Analyzers.SampleApp/Swa.Analyzers.SampleApp.csproj"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
