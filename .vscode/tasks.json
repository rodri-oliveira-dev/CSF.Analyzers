{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "restore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "restore",
                "${workspaceFolder}/Swa.Analyzers.slnx"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Swa.Analyzers.slnx",
                "-c",
                "Debug",
                "-m:1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/Swa.Analyzers.slnx",
                "-c",
                "Debug",
                "-m:1"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
